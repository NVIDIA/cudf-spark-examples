{
  "shared_paths": [
    ".github/gpu-ci-suites.json",
    ".github/workflows/gpu-ci.yml",
    ".github/workflows/gpu-ci-worker.yml"
  ],
  "suites": {
    "udf": {
      "enabled": true,
      "comment": "Native and non-native UDFs, including toolchain inputs; skip Markdown and publisher/cleanup-only changes.",
      "paths": [
        "examples/UDF-Examples/RAPIDS-accelerated-UDFs/",
        ".github/workflows/udf-build.yml"
      ],
      "exclude_paths": ["**/*.md"],
      "jobs": ["build", "gpu-test"]
    }
  }
}
