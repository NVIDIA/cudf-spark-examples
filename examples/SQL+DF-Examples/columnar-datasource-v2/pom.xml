<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.nvidia</groupId>
    <artifactId>columnar-datasource-v2-example_2.12</artifactId>
    <name>Columnar DataSource V2 Example</name>
    <description>A DataSource V2 source that returns Arrow-backed columnar batches,
        which the NVIDIA cuDF plugin for Apache Spark copies to the GPU in bulk</description>
    <version>26.12.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.major.version>8</java.major.version>
        <scala.binary.version>2.12</scala.binary.version>
        <spark.version>3.5.2</spark.version>
        <junit.version>4.13.2</junit.version>
        <test.jvm.args></test.jvm.args>
    </properties>

    <profiles>
        <profile>
            <!-- Spark and Arrow need these to run the tests on Java 17 -->
            <id>jdk9plus</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <test.jvm.args>--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED</test.jvm.args>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- Spark brings Arrow, Hadoop and Jackson at runtime -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.major.version}</source>
                    <target>${java.major.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>${test.jvm.args}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
